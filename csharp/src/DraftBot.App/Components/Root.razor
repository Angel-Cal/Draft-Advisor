<AppShell LeagueText="@LeagueText" Current="screen" OnNavigate="Show">
    @if (screen == Screen.Board)
    {
        <BoardScreen />
    }
    else if (screen == Screen.Players)
    {
        <PlayersScreen />
    }
    else
    {
        <DraftScreen />
    }
</AppShell>

@code {
    [Inject] PracticeDraft Session { get; set; } = default!;

    Screen screen = Screen.Draft;

    string LeagueText => $"Practice league · {Session.League.Teams} teams · PPR";

    void Show(Screen next) => screen = next;
}

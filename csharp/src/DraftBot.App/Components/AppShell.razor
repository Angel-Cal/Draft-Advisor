<div style="width:100%;min-width:0">
<header style="display:flex;flex-wrap:wrap;align-items:center;gap:12px 28px;padding:0 28px;border-bottom:1px solid #2A333F;background:#161B22">
<div style="display:flex;align-items:center;gap:10px;padding:14px 0">
<svg width="28" height="28" viewBox="0 0 28 28" fill="none" aria-hidden="true"><rect x="1" y="1" width="26" height="26" rx="7" fill="#F2B84B"/><path d="M8 20 L14 8 L20 20 M10.5 15.5 H17.5" stroke="#1A1303" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
<span style="font-weight:600;font-size:18px;letter-spacing:.01em">DraftBot</span>
</div>
<nav aria-label="Screens" style="display:flex;flex-wrap:wrap;align-items:center">
<a class="navlink on" aria-current="page">Draft</a>
<span class="navlink off" title="Coming in a later step">Players</span>
<span class="navlink off" title="Coming in a later step">Board</span>
</nav>
<div style="margin-left:auto;display:flex;flex-wrap:wrap;align-items:center;gap:10px 18px">
<span class="muted" style="font-size:13px">@LeagueText</span>
<span class="practice">Practice draft</span>
</div>
</header>
@ChildContent
</div>

@code {
    [Parameter] public string LeagueText { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}

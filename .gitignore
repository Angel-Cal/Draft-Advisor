# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
.env

# IDE
.vscode/
.idea/
*.swp
*.swo

# Jupyter Notebooks
notebooks/
.ipynb_checkpoints/

# Data files (large files should not be committed)
data/raw/*
data/processed/*
data/external/*
!data/**/.gitkeep

# Model files
models/*
!models/.gitkeep

# Logs
*.log
logs/

# Environment variables
.env
.env.local
config/secrets.yaml

# OS files
.DS_Store
Thumbs.db

# Test coverage
.coverage
htmlcov/
.pytest_cache/

# Build files
build/
dist/
*.egg-info/
